# ── Supabase (auth + database) ──────────────────────────────────────────────
# Create a project at https://supabase.com, then: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Project Settings → API → service_role (secret! server-only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AWS S3 (file storage) ───────────────────────────────────────────────────
# IAM user needs s3:PutObject, s3:GetObject, s3:DeleteObject, s3:ListBucket on the bucket
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# ── OpenAI (auto-tagging + natural-language search) ─────────────────────────
OPENAI_API_KEY=sk-...
# Optional overrides:
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Error tracking → GitHub issues ──────────────────────────────────────────
# The app files runtime errors directly as GitHub issues (no local storage).
# This token is used BY THE APP to create those issues — the cloud fix
# workflow authenticates itself and doesn't need it.
# Fine-grained PAT with Issues: read/write on the repo below.
# Shortcut for local dev: use the output of `gh auth token`.
GITHUB_TOKEN=github_pat_...
# owner/repo where error issues are filed and fix PRs are opened
GITHUB_REPO=Snoe0/open-pics
